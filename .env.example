# Orbit and Launch Alert v1.0.0 — example configuration
# Copy to .env (git-ignored) and adjust. Never commit real secrets.
# Full reference: docs/configuration.md

# --- Core -------------------------------------------------------------------
# demo | launches | satellites | iss | orbit_and_launch
OLA_MODE=demo
OLA_LAT=25.7816
OLA_LON=-80.2220
OLA_ALT_M=0
OLA_TIMEZONE=America/New_York
# mi | km
OLA_UNITS=mi
# 60..200 (MeshMonitor limit is 200)
OLA_MAX_LEN=200

# --- Rocket launches (The Space Devs Launch Library 2) ------------------------
OLA_LAUNCH_PROVIDER=launchlibrary2
OLA_LL2_BASE=https://ll.thespacedevs.com/2.3.0
# optional personal token; leave empty for anonymous access
OLA_LL2_API_KEY=
OLA_LAUNCH_LIMIT=25
OLA_LAUNCH_REFRESH_MINUTES=15
OLA_LAUNCH_MAX_AGE_HOURS=24
OLA_LAUNCH_ALERT_HOURS=24,1
OLA_LAUNCH_ALERT_MINUTES=15,0
OLA_ALERT_DELAYS=true
OLA_ALERT_HOLDS=true
OLA_ALERT_CANCELLATIONS=true
OLA_ALERT_OUTCOMES=true
OLA_ALERT_IN_FLIGHT=true
# e.g. USA,NZ
OLA_LAUNCH_COUNTRIES=
# e.g. spacex,ula,rocket lab,nasa
OLA_LAUNCH_AGENCIES=
# e.g. cape (Cape Canaveral + Kennedy), vandenberg, starbase
OLA_LAUNCH_SITES=
# e.g. falcon,electron
OLA_LAUNCH_ROCKETS=
# e.g. starlink,crew
OLA_LAUNCH_MISSIONS=
OLA_SHOW_DISTANCE=true

# --- Satellites (CelesTrak GP + local SGP4) -----------------------------------
OLA_SATELLITE_PROVIDER=celestrak
OLA_CELESTRAK_GP_URL=https://celestrak.org/NORAD/elements/gp.php
# e.g. stations,amateur,noaa
OLA_SATELLITE_GROUPS=stations
# e.g. 25544,48274
OLA_SATELLITE_IDS=
OLA_MIN_ELEVATION_DEG=30
OLA_LOOKAHEAD_HOURS=24
OLA_GP_REFRESH_HOURS=12
OLA_MAX_ELEMENT_AGE_DAYS=7
OLA_MAX_SATELLITES=20
OLA_PASS_ALERT_MINUTES=10
OLA_ISS_VISIBLE_ONLY=false
OLA_COMPUTE_BUDGET_SECONDS=15

# --- Runtime ------------------------------------------------------------------
OLA_POLL_INTERVAL=300
OLA_SUPPRESS_MINUTES=15
OLA_CACHE_DIR=./cache
OLA_HTTP_TIMEOUT=10
# optional; default <script dir>/ola_vendor
OLA_VENDOR_DIR=
OLA_DEBUG=false

# --- MQTT (optional, disabled when OLA_MQTT_HOST is empty) --------------------
OLA_MQTT_HOST=
OLA_MQTT_PORT=1883
OLA_MQTT_TOPIC=orbit-and-launch-alert/events
OLA_MQTT_USERNAME=
OLA_MQTT_PASSWORD=
OLA_MQTT_TLS=false
OLA_MQTT_ALLOW_IN_MESHMONITOR=false
